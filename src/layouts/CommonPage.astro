---
import type { MarkdownHeading } from 'astro'

import PageLayout from '@/layouts/ContentLayout.astro'
import PageViews from '@/components/views/PageViews.astro'
import { Comment } from '@/components/waline'
import config from 'virtual:config'

interface Props {
  title: string
  description?: string
  headings?: MarkdownHeading[]
  view?: boolean
  comment?: boolean
}

const { title, description, headings, view, comment: enableComment, ...props } = Astro.props
---

<PageLayout meta={{ title, description }} {...props} {headings}>
  <Fragment slot='header'>
    <h1 class='ln-page-title'>{title}</h1>
    {description && <p class='ln-article-lead'>{description}</p>}
    {view && <PageViews />}
  </Fragment>

  <slot />

  <slot name='bottom' slot='bottom'>
    {enableComment && config.integ.waline.enable && <Comment class='mt-3 sm:mt-6' />}
  </slot>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>
