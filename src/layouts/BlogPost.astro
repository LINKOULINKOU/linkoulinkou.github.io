---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import PageLayout from '@/layouts/ContentLayout.astro'
import ArticleHeader from '@/components/content/ArticleHeader.astro'
import PostNavigation from '@/components/content/PostNavigation.astro'
import Copyright from '@/components/blog/Copyright.astro'
import PageViews from '@/components/views/PageViews.astro'
import { Comment } from '@/components/waline'
import config from 'virtual:config'

interface Props {
  post: CollectionEntry<'blog'>
  posts: CollectionEntry<'blog'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data },
  posts,
  headings
} = Astro.props

const { heroImage, publishDate, updatedDate, draft: isDraft, comment: enableComment } = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? heroImage.src
    : heroImage.src.src
  : config.socialCard
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
---

<PageLayout meta={{ articleDate, description: data.description, ogImage: socialImage, title: data.title }} back='/blog' {headings}>
  <Fragment slot='header'>
    <ArticleHeader {data}>
      <PageViews slot='views' />
    </ArticleHeader>
  </Fragment>

  <slot />

  <Fragment slot='bottom'>
    <PostNavigation {id} {posts} />
    <Copyright {data} />
    {!isDraft && enableComment && config.integ.waline.enable && <Comment class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{config.integ.mediumZoom.enable && <MediumZoom />}
