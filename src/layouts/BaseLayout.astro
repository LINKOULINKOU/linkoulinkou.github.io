---
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import DecorStyles from '@/components/decor/DecorStyles.astro'
import HeaderSearch from '@/components/search/HeaderSearch.astro'
import SiteFooter from '@/components/site/SiteFooter.astro'
import SiteHeader from '@/components/site/SiteHeader.astro'
import Toast from '@/components/site/Toast.astro'
import config from '@/site-config'

import '@/assets/styles/tokens.css'
import '@/assets/styles/app.css'
import '@/assets/styles/global.css'
import '@/assets/styles/jump-link.css'
import '@/assets/styles/pixel-frame.css'

interface Props {
  meta: SiteMeta
}
const {
  meta: { articleDate, description = config.description, ogImage, title }
} = Astro.props
const isSearchPage = Astro.url.pathname.replace(/\/$/, '') === '/search'
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <DecorStyles />
  </head>
  <body id='top'>
    <a class='ln-skip-link' href='#content'>跳到正文</a>
    <div class='ln-shell'>
      <SiteHeader />
      {!isSearchPage && <HeaderSearch />}
      <main class='ln-main' id='content' tabindex='-1'><slot /></main>
      <SiteFooter />
    </div>
    <Toast />
  </body>
</html>

<style>
  .ln-shell {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    width: min(var(--ln-page-max), calc(100% - var(--ln-page-inset) * 2));
    margin-inline: auto;
    padding-block-end: var(--ln-space-8);
  }
  .ln-main {
    flex: 1 0 auto;
    min-width: 0;
    padding-top: var(--ln-content-top);
    padding-bottom: var(--ln-space-16);
  }
  .ln-skip-link {
    position: fixed;
    inset-block-start: var(--ln-space-2);
    inset-inline-start: var(--ln-page-inset);
    z-index: 10;
    padding: var(--ln-space-3) var(--ln-space-4);
    background: hsl(var(--ln-color-bg));
    color: hsl(var(--ln-color-accent));
    text-decoration: none;
    transform: translateY(-200%);
  }
  .ln-skip-link:focus {
    transform: none;
  }
</style>
