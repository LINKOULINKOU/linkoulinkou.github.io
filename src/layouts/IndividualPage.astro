---
/** 条款 Markdown 同样使用共用阅读布局，不再自建居中外框。 */
import type { MarkdownHeading, MarkdownLayoutProps } from 'astro'
import ContentLayout from '@/layouts/ContentLayout.astro'

type Props = MarkdownLayoutProps<{
  title: string
  description: string
  language?: string
  back?: string
}> & { headings: MarkdownHeading[] }
const { frontmatter, headings = [] } = Astro.props
const { title, description, language, back } = frontmatter
---

<ContentLayout meta={{ title, description }} {back} {headings}>
  <Fragment slot='header'>
    <h1 class='ln-page-title'>{title}</h1>
    {(description || language) && (
      <p class='ln-article-meta'>
        {language && <span>{language}</span>}
        {description && <span>{description}</span>}
      </p>
    )}
  </Fragment>
  <slot />
</ContentLayout>
