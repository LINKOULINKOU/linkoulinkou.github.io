---
/** 阅读布局只负责「文章头 + 正文 + 目录」的内部编排；主轴由 BaseLayout 唯一持有。 */
import type { MarkdownHeading } from 'astro'

import type { SiteMeta } from 'astro-pure/types'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'

import '@/assets/styles/article.css'
import '@/assets/styles/reading.css'

interface Props {
  meta: SiteMeta
  back?: string
  headings?: MarkdownHeading[]
}
const { meta, back, headings = [] } = Astro.props
const backLabel = back === '/blog' ? '返回文章' : back === '/tracking' ? '返回追踪' : '返回'
const hasToc = headings.some(({ depth }) => depth === 2 || depth === 3)
---

<BaseLayout {meta}>
  {
    back && (
      <div class='ln-back-row'>
        <JumpLink href={back} label={backLabel} direction='back' />
        <span class='ln-reading-label' aria-hidden='true'>{back === '/tracking' ? 'FIELD NOTES' : back === '/blog' ? 'PERSONAL WRITING' : 'THE LOGBOOK'}</span>
      </div>
    )
  }
  <div class='ln-reading'>
    <article class='ln-reading__main' data-pagefind-body>
      <header class='ln-reading__head'><slot name='header' /></header>
      {
        hasToc && (
          <details class='ln-toc-mobile' data-pagefind-ignore>
            <summary>目录</summary>
            <TableOfContents {headings} compact />
          </details>
        )
      }
      <div class='ln-reading__body'>
        <div class='ln-prose prose'><slot /></div>
        {
          hasToc && (
            <aside class='ln-reading__toc' aria-label='目录' data-pagefind-ignore>
              <TableOfContents {headings} />
            </aside>
          )
        }
      </div>
    </article>
    <div class='ln-reading__footer'><slot name='bottom' /></div>
  </div>
  <slot name='bottom-sidebar' />
</BaseLayout>
