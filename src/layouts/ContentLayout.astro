---
/** 阅读布局只负责「文章头 + 正文 + 目录」的内部编排；主轴由 BaseLayout 唯一持有。 */
import type { MarkdownHeading } from 'astro'

import type { SiteMeta } from 'astro-pure/types'
import BaseLayout from '@/layouts/BaseLayout.astro'
import TableOfContents from '@/components/navigation/TableOfContents.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'

import '@/assets/styles/article.css'
import '@/assets/styles/reading.css'

interface Props {
  meta: SiteMeta
  back?: string
  headings?: MarkdownHeading[]
}
const { meta, back, headings = [] } = Astro.props
const backLabel = back === '/blog' ? '返回文章' : back === '/tracking' ? '返回追踪' : '返回'
const hasToc = headings.some(({ depth }) => depth === 2 || depth === 3)
---

<BaseLayout {meta}>
  {
    back && (
      <div class='ln-back-row'>
        <JumpLink href={back} label={backLabel} direction='back' />
        <span class='ln-reading-label' aria-hidden='true'>{back === '/tracking' ? 'FIELD NOTES' : back === '/blog' ? 'PERSONAL WRITING' : 'THE LOGBOOK'}</span>
      </div>
    )
  }
  <div class='ln-reading'>
    <article class='ln-reading__main' data-pagefind-body>
      <header class='ln-reading__head'><slot name='header' /></header>
      <script is:inline>
        // 标题单行自适应：按长度在 20–30px 间取值，尽量铺满正文栏。
        // 放不进一行时退回 26px 基准并允许正常换行；无 JS 时保持 CSS 默认。
        ;(() => {
          const MIN = 20
          const MAX = 30

          const fit = () => {
            for (const title of document.querySelectorAll('.ln-article-title')) {
              let text = title.querySelector(':scope > .ln-title-fit')
              if (!text) {
                text = document.createElement('span')
                text.className = 'ln-title-fit'
                while (title.firstChild) text.appendChild(title.firstChild)
                title.appendChild(text)
              }

              const available = title.clientWidth - 1
              title.style.whiteSpace = 'nowrap'

              const measure = (size) => {
                title.style.fontSize = size + 'px'
                return text.getBoundingClientRect().width
              }

              let size = MAX
              if (measure(MAX) > available) {
                let low = MIN
                let high = MAX
                while (high - low > 0.1) {
                  const mid = (low + high) / 2
                  if (measure(mid) <= available) low = mid
                  else high = mid
                }
                size = low
              }

              if (measure(size) > available) {
                title.style.whiteSpace = ''
                title.style.fontSize = ''
              } else {
                title.style.fontSize = Math.floor(size * 10) / 10 + 'px'
              }
            }
          }

          fit()
          let timer = 0
          window.addEventListener(
            'resize',
            () => {
              clearTimeout(timer)
              timer = window.setTimeout(fit, 120)
            },
            { passive: true }
          )
        })()
      </script>
      {
        hasToc && (
          <details class='ln-toc-mobile' data-pagefind-ignore>
            <summary>目录</summary>
            <TableOfContents {headings} compact />
          </details>
        )
      }
      <div class='ln-reading__body'>
        <div class='ln-prose prose'><slot /></div>
        {
          hasToc && (
            <aside class='ln-reading__toc' aria-label='目录' data-pagefind-ignore>
              <TableOfContents {headings} />
            </aside>
          )
        }
      </div>
    </article>
    <div class='ln-reading__footer'><slot name='bottom' /></div>
  </div>
  <slot name='bottom-sidebar' />
</BaseLayout>
