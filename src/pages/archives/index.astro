---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/lib/format-date'

import { getBlogCollection, groupCollectionsByYear, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/PageLayout.astro'
import EntryLink from '@/components/content/EntryLink.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'

export const prerender = true
const posts = sortMDByDate(await getBlogCollection()) as CollectionEntry<'blog'>[]
const allPostsByYear = groupCollectionsByYear(posts) as [number, CollectionEntry<'blog'>[]][]
const meta = { description: '全部文章按年归档', title: '文章归档' }
---

<PageLayout {meta} title='文章归档'>
  <Fragment slot='tools'>
    <span>共 {posts.length} 篇</span>
    <JumpLink href='/blog' label='文章列表' />
    <JumpLink href='/tracking' label='前往追踪' />
  </Fragment>
  <div class='ln-archive'>
    {
      allPostsByYear.length === 0 ? (
        <p class='ln-archive__empty'>暂无文章。</p>
      ) : (
        allPostsByYear.map(([year, yearPosts]) => (
          <section class='ln-year ln-page-section' aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>
              <span class='ln-year__number'>{year}</span>
              <span class='ln-year__count'>{yearPosts.length} 篇文章</span>
            </h2>
            <ul>
              {yearPosts.map((post) => (
                <li>
                  <EntryLink
                    href={`/blog/${post.id}`}
                    title={post.data.title}
                    date={formatDate(post.data.publishDate)}
                    variant='short'
                  />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</PageLayout>

<style>
  .ln-archive {
    display: grid;
    row-gap: var(--ln-space-4);
  }
  .ln-year {
    display: grid;
  }
  .ln-year h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--ln-space-3);
    margin: 0;
  }
  .ln-year__number {
    color: hsl(var(--ln-color-ink));
    font-family: var(--ln-font-mono);
    font-size: var(--ln-text-base);
    font-weight: var(--ln-weight-normal);
    line-height: var(--ln-leading-title);
    font-variant-numeric: tabular-nums;
  }
  .ln-year__count {
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    font-weight: var(--ln-weight-normal);
  }
  .ln-year ul {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ln-archive__empty {
    padding-block: var(--ln-space-6);
    color: hsl(var(--ln-color-muted));
  }
  @media (min-width: 40em) {
    .ln-year h2 {
      display: grid;
      align-content: start;
      gap: var(--ln-space-3);
    }
    .ln-year__number {
      line-height: var(--ln-leading-ui);
    }
    .ln-year li:first-child :global(.ln-entry) {
      padding-top: 0;
    }
    .ln-year li:last-child :global(.ln-entry) {
      padding-bottom: 0;
    }
  }
</style>
