---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/PageLayout.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'

const allTags = getUniqueTagsWithCount(await getBlogCollection())
const meta = { description: '按标签浏览全部文章', title: '标签' }
---

<PageLayout {meta} title='标签' description={`目前有 ${allTags.length} 个标签，点一个看看。`}>
  <JumpLink slot='tools' href='/blog' label='返回文章列表' direction='back' />

  {
    allTags.length > 0 ? (
      <div class='ln-tag-index'>
        <div class='ln-tag-index__head' aria-hidden='true'>
          <span>标签索引</span><span>文章数</span>
        </div>
        <ul class='ln-tags'>
          {allTags.map(([tag, count], index) => (
            <li>
              <a href={`/tags/${tag}`}>
                <span class='ln-tags__number' aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span>
                <span class='ln-tags__name'>{tag}</span>
                <span class='ln-tags__count'>{count}<span class='ln-tags__unit'> 篇</span></span>
                <span class='ln-tags__arrow' aria-hidden='true'>↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <p class='ln-empty'>暂无标签。</p>
    )
  }
</PageLayout>

<style>
  .ln-tag-index {
    padding-block: var(--ln-space-6);
  }
  .ln-tag-index__head {
    display: flex;
    justify-content: space-between;
    gap: var(--ln-space-4);
    padding-block: var(--ln-space-4);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
  }
  .ln-tags {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ln-tags li {
    min-width: 0;
  }
  .ln-tags a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: baseline;
    gap: var(--ln-space-4);
    min-height: var(--ln-hit-min);
    padding-block: var(--ln-space-4);
    color: hsl(var(--ln-color-ink));
    text-decoration: none;
    transition: color var(--ln-motion-hover) var(--ln-ease-standard);
  }
  .ln-tags a:hover,
  .ln-tags a:focus-visible {
    color: hsl(var(--ln-color-accent));
  }
  .ln-tags__name {
    font-size: var(--ln-text-list-title);
    font-weight: var(--ln-weight-medium);
    overflow-wrap: anywhere;
  }
  .ln-tags__number,
  .ln-tags__count {
    color: hsl(var(--ln-color-muted));
    font-family: var(--ln-font-mono);
    font-size: var(--ln-text-meta);
    font-variant-numeric: tabular-nums;
  }
  .ln-tags__unit {
    font-family: var(--ln-font-sans);
  }
  .ln-tags__arrow {
    color: hsl(var(--ln-color-accent));
  }
  .ln-empty {
    margin: 0;
    padding-block: var(--ln-space-8);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-sm);
  }
  @media (min-width: 40em) {
    .ln-tag-index__head {
      padding-inline: 40px var(--ln-space-8);
      padding-bottom: var(--ln-space-6);
    }
    .ln-tags {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--ln-space-2) var(--ln-space-16);
    }
    .ln-tags a {
      grid-template-columns: var(--ln-space-6) minmax(0, 1fr) auto var(--ln-space-4);
      column-gap: var(--ln-space-4);
    }
    .ln-tags__number {
      color: hsl(var(--ln-color-faint));
      font-size: var(--ln-text-micro);
    }
    .ln-tags__arrow {
      opacity: 0;
      transition: opacity var(--ln-motion-hover) var(--ln-ease-standard);
    }
    .ln-tags a:hover .ln-tags__arrow,
    .ln-tags a:focus-visible .ln-tags__arrow {
      opacity: 1;
    }
  }
</style>
