---
import type { GetStaticPaths } from 'astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'

import PageLayout from '@/layouts/ContentLayout.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'
import { formatDate } from '@/lib/format-date'

interface Props {
  entry: CollectionEntry<'tracking'>
}

export const prerender = true

export const getStaticPaths = (async () => {
  const entries = await getCollection('tracking')
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const { title, kind } = entry.data
const dateStr = formatDate(entry.data.date)
const kindLabel = { hotnews: '热点追踪', topic: '专题调研', release: '发布线' }[kind]
const back = '/tracking'

const meta = {
  title,
  description: `${kindLabel} · ${dateStr} · ${title}`
}
---

<PageLayout {meta} {back} {headings}>
  <Fragment slot='header'>
    <h1 class='ln-article-title'>{title}</h1>
    <p class='ln-article-meta'>
      <span>{kindLabel}</span>
      <time datetime={dateStr}>{dateStr}</time>
    </p>
  </Fragment>

  <Content />

  <Fragment slot='bottom'>
    <footer class='ln-detail-foot'>
      <JumpLink href='/tracking' label='返回追踪' direction='back' />
      <p class='ln-detail-foot__meta'>
        {kindLabel} · <time datetime={dateStr}>{dateStr}</time> · LINKOULINKOU
      </p>
    </footer>
  </Fragment>
</PageLayout>

<style is:global>
  /* 「调研说明」折叠框（HTML 由 scripts/sync-tracking.mjs 生成）在 article.css 里；
     这里只保留研究页自己的收尾：返回入口 + 署名。 */
  .ln-detail-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ln-space-3);
    margin-top: var(--ln-space-8);
    padding-top: var(--ln-space-4);
    border-top: var(--ln-border-width) solid hsl(var(--ln-color-line));
    font-size: var(--ln-text-meta);
  }

  .ln-detail-foot__meta {
    margin: 0;
    color: hsl(var(--ln-color-muted));
    font-variant-numeric: tabular-nums;
  }
</style>
