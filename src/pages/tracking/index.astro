---
import { getCollection } from 'astro:content'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import MonthList from '@/components/tracking/MonthList.astro'

export const prerender = true

const entries = await getCollection('tracking')
const hotnews = entries.filter((entry) => entry.data.kind === 'hotnews')
const topics = entries.filter((entry) => entry.data.kind === 'topic')
const releases = entries.filter((entry) => entry.data.kind === 'release')

const meta = {
  title: 'Tracking',
  description: '模型与 Agent 发布线、工程热点追踪与专题调研归档'
}
---

<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-2 mt-6 text-3xl font-medium sm:mt-10'>Tracking</h1>
      <p class='text-sm text-muted-foreground sm:text-base'>
        发布线广泛收录模型与 Agent 的发布、更新；热点精选值得展开的高价值变化，专题深入调研。
      </p>
    </div>

    <div id='content' class='animate mt-10 flex flex-col gap-y-14'>
      <section aria-labelledby='hotnews-title'>
        <h2 id='hotnews-title' class='text-xl font-medium'>热点</h2>
        <MonthList entries={hotnews} emptyMessage='暂无热点记录。' unit='期' />
      </section>

      <section aria-labelledby='releases-title'>
        <div class='flex flex-wrap items-center justify-between gap-3'>
          <h2 id='releases-title' class='text-xl font-medium'>发布线</h2>
          <a class='text-sm text-muted-foreground hover:text-primary' href='/tracking/releases'>
            查看全部发布记录 →
          </a>
        </div>
        <MonthList entries={releases} emptyMessage='暂无发布记录。' unit='期' />
      </section>

      <section aria-labelledby='topics-title'>
        <h2 id='topics-title' class='text-xl font-medium'>专题</h2>
        <MonthList entries={topics} emptyMessage='暂无专题记录。' />
      </section>
    </div>
  </main>
</PageLayout>
