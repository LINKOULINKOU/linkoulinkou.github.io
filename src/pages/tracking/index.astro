---
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/PageLayout.astro'
import MonthList from '@/components/tracking/MonthList.astro'
import TrackingTabs from '@/components/tracking/TrackingTabs.astro'

export const prerender = true
const entries = await getCollection('tracking')
const hotnews = entries.filter(({ data }) => data.kind === 'hotnews')
const topics = entries.filter(({ data }) => data.kind === 'topic')
const meta = { title: '前沿追踪', description: '工程热点追踪与专题调研归档' }
---

<PageLayout {meta} title='前沿追踪' description='按天记录，值得展开的写成专题。'>
  <TrackingTabs slot='filters' hotnewsCount={hotnews.length} topicsCount={topics.length} />
  <div class='ln-tracking'>
    <section id='hotnews' aria-labelledby='hotnews-heading'>
      <div class='ln-tracking__section-head'>
        <h2 id='hotnews-heading'>热点记录</h2>
        <p>按月归档 <span aria-hidden='true'>/</span> {hotnews.length} 期</p>
      </div>
      <MonthList entries={hotnews} emptyMessage='暂无热点记录。' unit='期' kind='hotnews' />
    </section>
    <section id='topics' aria-labelledby='topics-heading'>
      <div class='ln-tracking__section-head'>
        <h2 id='topics-heading'>专题调研</h2>
        <p>按月归档 <span aria-hidden='true'>/</span> {topics.length} 篇</p>
      </div>
      <MonthList entries={topics} emptyMessage='暂无专题记录。' unit='篇' kind='topics' />
    </section>
  </div>
</PageLayout>

<style>
  .ln-tracking > section {
    scroll-margin-top: var(--ln-space-8);
  }
  .ln-tracking > section:not([hidden]) ~ section:not([hidden]) {
    margin-top: var(--ln-space-12);
  }
  .ln-tracking__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ln-space-3) var(--ln-space-6);
    padding-block: var(--ln-space-2) var(--ln-space-6);
  }
  .ln-tracking__section-head h2 {
    margin: 0;
    color: hsl(var(--ln-color-ink));
    font-size: var(--ln-text-section);
    font-weight: var(--ln-weight-medium);
  }
  .ln-tracking__section-head p {
    display: flex;
    gap: var(--ln-space-3);
    margin: 0;
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    font-variant-numeric: tabular-nums;
  }
</style>
