---
import { getCollection } from 'astro:content'

import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import MonthList from '@/components/tracking/MonthList.astro'

export const prerender = true

const entries = await getCollection('tracking')
const meta = {
  title: '发布线 · Tracking',
  description: '发布要点收在热点稿的「发布速览」，每项最多三句话；此处直达各期板块。'
}
---

<PageLayout {meta}>
  <Button title='Tracking' href='/tracking' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-2 mt-6 text-3xl font-medium sm:mt-10'>发布线</h1>
      <p class='text-sm text-muted-foreground sm:text-base'>
        发布要点收在热点稿的「发布速览」，每项最多三句话；此处直达各期板块。
      </p>
    </div>
    <div id='content' class='animate mt-10'>
      <MonthList entries={entries} releaseView emptyMessage='暂无发布记录。' unit='期' />
    </div>
  </main>
</PageLayout>
