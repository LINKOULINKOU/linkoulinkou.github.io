---
import { getCollection } from 'astro:content'
import { formatDate } from '@/lib/format-date'

import BaseLayout from '@/layouts/BaseLayout.astro'
import EntryLink from '@/components/content/EntryLink.astro'
import SectionHead from '@/components/site/SectionHead.astro'

const tracking = await getCollection('tracking')
const byDate = (a: (typeof tracking)[number], b: (typeof tracking)[number]) =>
  b.data.date.valueOf() - a.data.date.valueOf()
const updates = tracking
  .filter(({ data }) => data.kind !== 'release')
  .sort(byDate)
  .slice(0, 6)
const topics = tracking
  .filter(({ data }) => data.kind === 'topic')
  .sort(byDate)
  .slice(0, 3)
const notes = (await getCollection('blog'))
  .filter(({ data }) => data.tags.includes('随笔') && !data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)
const kindLabel = { hotnews: '热点', topic: '专题', release: '发布线' } as const
---

<BaseLayout meta={{ title: '首页' }}>
  <h1 class='sr-only'>LINKOULINKOU</h1>
  <div class='ln-home'>
    <section aria-label='最近更新'>
      <SectionHead title='最近更新' href='/tracking' label='全部追踪' accent />
      {updates[0] && <div class='ln-home__lead ln-pixel-frame ln-pixel-frame--accent'>
        <span class='ln-home__motif ln-pixel-motif' aria-hidden='true'></span>
        <EntryLink
          href={`/tracking/${updates[0].id}`}
          title={updates[0].data.title}
          date={formatDate(updates[0].data.date)}
          kind={kindLabel[updates[0].data.kind]}
          feature
        />
      </div>}
      {updates.length > 1 && <div class='ln-home__history'>
        <p class='ln-home__history-label'>此前记录 <span aria-hidden='true'>/ EARLIER</span></p>
        <ol class='ln-home__list'>
          {updates.slice(1).map((entry) => (
            <li>
              <EntryLink
                href={`/tracking/${entry.id}`}
                title={entry.data.title}
                date={formatDate(entry.data.date)}
                kind={kindLabel[entry.data.kind]}
                variant='timeline'
              />
            </li>
          ))}
        </ol>
      </div>}
      {updates.length === 0 && <p class='ln-home__empty'>暂无记录。</p>}
    </section>
    <aside class='ln-home__side' aria-label='专题与随笔'>
      <section class='ln-home__topics ln-pixel-frame'>
        <SectionHead title='专题精选' href='/tracking#topics' label='全部专题' index='02' english='IN FOCUS' accent />
        <ul class='ln-home__list'>
          {
            topics.map((entry, i) => (
              <li>
                <EntryLink
                  href={`/tracking/${entry.id}`}
                  title={entry.data.title}
                  date={formatDate(entry.data.date)}
                  index={String(i + 1).padStart(2, '0')}
                  variant='stacked'
                />
              </li>
            ))
          }
        </ul>
        {topics.length === 0 && <p class='ln-home__empty'>暂无专题。</p>}
      </section>
      <section>
        <SectionHead title='随笔' href='/blog' label='全部文章' index='03' english='PERSONAL WRITING' accent />
        <ul class='ln-home__list'>
          {
            notes.map((post) => (
              <li>
                <EntryLink
                  href={`/blog/${post.id}`}
                  title={post.data.title}
                  date={formatDate(post.data.publishDate)}
                  variant='stacked'
                />
              </li>
            ))
          }
        </ul>
        {notes.length === 0 && <p class='ln-home__empty'>暂无文章。</p>}
      </section>
    </aside>
  </div>
</BaseLayout>

<style>
  .ln-home {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ln-space-12);
    align-items: start;
  }
  .ln-home__side {
    display: grid;
    gap: var(--ln-space-8);
    min-width: 0;
  }
  .ln-home__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ln-home__lead { margin: var(--ln-space-3) 0 var(--ln-space-8); padding: var(--ln-space-6) var(--ln-space-8); }
  .ln-home__lead :global(.ln-entry--feature) { padding: 0; }
  .ln-home__lead :global(.ln-entry__title) { line-height: var(--ln-leading-ui); max-width: 30em; }
  .ln-home__motif { position: absolute; inset-block-start: var(--ln-space-6); inset-inline-end: var(--ln-space-6); }
  .ln-home__history { padding-top: var(--ln-space-2); }
  .ln-home__history :global(.ln-entry--timeline) { padding-block: var(--ln-space-5); }
  .ln-home__side > section { padding: var(--ln-space-6); }
  .ln-home__side :global(.ln-entry--stacked) { padding-block: var(--ln-space-5); }
  .ln-home__side :global(.ln-entry__title) { line-height: var(--ln-leading-lead); }
  .ln-home__side :global(.ln-section-head) { gap: var(--ln-space-2); }
  .ln-home__side :global(.ln-section-head__eyebrow) { letter-spacing: 0.075em; }
  .ln-home__side :global(.ln-section-head__enter) { font-size: var(--ln-text-micro); gap: var(--ln-space-1); }
  .ln-home__history-label { display: flex; align-items: center; gap: var(--ln-space-3); margin: 0 0 var(--ln-space-2); color: hsl(var(--ln-color-muted)); font-size: var(--ln-text-meta); }
  .ln-home__history-label > span { font: var(--ln-text-micro) / var(--ln-leading-meta) var(--ln-font-mono); letter-spacing: var(--ln-tracking-label); }
  .ln-home__empty {
    margin-top: var(--ln-space-4);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
  }
  @media (min-width: 72em) {
    .ln-home {
      grid-template-columns: minmax(0, 1fr) var(--ln-width-sidebar);
      gap: var(--ln-home-gap);
    }
  }
</style>
