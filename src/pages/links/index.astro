---
import links from '@/public/links.json'

import PageLayout from '@/layouts/PageLayout.astro'
import FriendList from '@/components/links/FriendList.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'
import config from 'virtual:config'

const { friends } = links
const linksConf = config.integ.links
const applyItems = linksConf.applyTip ?? []
const editUrl = 'https://github.com/LINKOULINKOU/linkoulinkou.github.io/blob/main/public/links.json'
const meta = { title: '友链', description: '友链与申请说明' }
const groups = friends.filter((group) => group.link_list.length > 0)
const groupTitles: Record<string, string> = {
  'cf-links': '友链',
  'inactive-links': '非活跃链接',
  'special-links': '其他链接'
}
---

<PageLayout {meta} title='友链'>
  <JumpLink slot='tools' href={editUrl} label='提交 PR' direction='external' external />

  <section class='ln-friend-block' aria-labelledby='friend-title'>
    <h2 id='friend-title'>站点</h2>
    <div class='ln-friend-block__body'>
      {
        groups.length > 0 ? (
          groups.map((group) => <FriendList list={group} title={groupTitles[group.id_name]} />)
        ) : (
          <p class='ln-empty'>暂无友链。</p>
        )
      }
    </div>
  </section>

  <section class='ln-friend-block' aria-labelledby='apply-title'>
    <h2 id='apply-title'>申请友链</h2>
    <div class='ln-friend-block__body ln-friend-block__application ln-pixel-frame'>
      <p class='ln-friend-note'>申请前请先在您的站点添加本站链接，然后提交 PR。</p>
      <dl class='ln-friend-apply'>
        {
          applyItems.map(({ name, val }) => (
            <div><dt>{name}</dt><dd>{val}</dd></div>
          ))
        }
      </dl>
      <ul class='ln-friend-rules'>
        <li>站点可正常访问，且有正式域名</li>
        <li>至少 5 篇原创文章，最近一年有更新</li>
        <li>内容不违反法律法规</li>
      </ul>
      <div class='ln-friend-action'>
        <JumpLink href={editUrl} label='提交友链信息' direction='external' external />
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .ln-friend-block {
    display: grid;
    gap: var(--ln-space-6);
    padding-block: var(--ln-space-8);
  }
  .ln-friend-block h2 {
    margin: 0;
    font-size: var(--ln-text-sm);
    font-weight: var(--ln-weight-medium);
    line-height: var(--ln-leading-ui);
  }
  .ln-friend-block__body {
    min-width: 0;
  }
  .ln-friend-note,
  .ln-empty {
    margin: 0;
    color: hsl(var(--ln-color-body));
    font-size: var(--ln-text-base);
    line-height: var(--ln-leading-reading);
  }
  .ln-empty {
    padding-block: var(--ln-space-4) var(--ln-space-8);
    color: hsl(var(--ln-color-muted));
  }
  .ln-friend-apply {
    margin: var(--ln-space-6) 0 0;
  }
  .ln-friend-apply div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--ln-space-4);
    padding-block: var(--ln-space-4);
    font-size: var(--ln-text-sm);
    line-height: var(--ln-leading-reading);
  }
  .ln-friend-apply dt {
    color: hsl(var(--ln-color-muted));
  }
  .ln-friend-apply dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .ln-friend-rules {
    display: grid;
    gap: var(--ln-space-2);
    margin: var(--ln-space-6) 0 0;
    padding-left: var(--ln-space-4);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-sm);
    line-height: var(--ln-leading-reading);
    list-style-type: square;
  }
  .ln-friend-rules li::marker {
    color: hsl(var(--ln-color-accent));
  }
  .ln-friend-action {
    margin-top: var(--ln-space-6);
  }
  @media (min-width: 40em) {
    .ln-friend-block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      gap: var(--ln-space-8);
      padding-block: var(--ln-space-10);
    }
    .ln-friend-block:has(.ln-friend-block__application) > h2 {
      padding-top: var(--ln-space-8);
    }
    .ln-friend-block__application {
      padding: var(--ln-space-8);
      margin-inline-start: calc(-1 * var(--ln-space-8));
    }
    .ln-friend-apply {
      display: grid;
      gap: var(--ln-space-3);
    }
    .ln-friend-apply div {
      grid-template-columns: 80px minmax(0, 1fr);
      padding-block: 0;
    }
  }
</style>
