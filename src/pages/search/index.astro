---
import PageLayout from '@/layouts/PageLayout.astro'
import SearchPanel from '@/components/search/SearchPanel.astro'
import { integ } from '@/site-config'

const meta = {
  description: '搜索站内文章与前沿追踪',
  title: '站内搜索'
}
---

<PageLayout {meta} title='站内搜索'>
  <div class='ln-search'>
    {
      integ.pagefind ? (
        <SearchPanel focusOnTrigger />
      ) : (
        <p class='ln-empty'>搜索暂不可用，可浏览文章或追踪。</p>
      )
    }
    <p class='ln-search__hint'>
      索引在构建时生成，不包含草稿。也可以直接浏览<a href='/blog'>文章</a>或<a href='/tracking'>前沿追踪</a>。
    </p>
  </div>
</PageLayout>

<style>
  .ln-search {
    max-width: var(--ln-width-search);
  }

  .ln-search__hint {
    margin: var(--ln-space-8) 0 0;
    padding-top: var(--ln-space-4);
    border-top: var(--ln-border-width) solid hsl(var(--ln-color-line));
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-sm);
    line-height: var(--ln-leading-ui);
  }

  .ln-search__hint a {
    color: hsl(var(--ln-color-accent));
    font-weight: var(--ln-weight-medium);
    text-decoration: none;
    transition: background-color var(--ln-motion-hover) var(--ln-ease-standard);
  }

  .ln-search__hint a:hover {
    background-color: hsl(var(--ln-color-hover));
  }

  .ln-empty {
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-sm);
  }
</style>




