---
import PageLayout from '@/layouts/PageLayout.astro'
import { terms } from '@/site-config'

const meta = {
  title: '站点说明',
  description: '站点说明与条款入口'
}
---

<PageLayout {meta} title='站点说明'>
  <ul class='ln-terms'>
    {
      terms.list.map((item) => (
        <li>
          <a href={item.link}>{item.title}</a>
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .ln-terms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ln-space-2) var(--ln-space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--ln-text-sm);
  }

  .ln-terms a {
    display: inline-flex;
    align-items: center;
    min-height: var(--ln-hit-min);
    padding: var(--ln-space-2) var(--ln-space-3);
    border: var(--ln-border-width) solid hsl(var(--ln-color-line));
    color: hsl(var(--ln-color-muted));
    text-decoration: none;
    transition:
      color var(--ln-motion-fast) var(--ln-ease-standard),
      border-color var(--ln-motion-fast) var(--ln-ease-standard),
      background-color var(--ln-motion-fast) var(--ln-ease-standard);
  }

  .ln-terms a:hover {
    border-color: hsl(var(--ln-color-accent));
    background-color: hsl(var(--ln-color-hover));
  }

  .ln-terms a:active {
    background-color: hsl(var(--ln-color-press));
    box-shadow: inset 0 0 0 var(--ln-inset-ring) hsl(var(--ln-color-accent));
  }
</style>

