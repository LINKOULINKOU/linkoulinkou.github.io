---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/PageLayout.astro'
import PostPreview from '@/components/content/PostPreview.astro'
import Pagination from '@/components/navigation/Pagination.astro'
import JumpLink from '@/components/navigation/JumpLink.astro'
import config from '@/site-config'

export const prerender = true
export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  return paginate(collections, { pageSize: config.content.blogPageSize })
}) satisfies GetStaticPaths
interface Props {
  page: Page<CollectionEntry<'blog'>>
}
const { page } = Astro.props
const meta = { description: '文章列表与年度归档', title: '文章' }
---

<PageLayout {meta} title='文章'>
  <Fragment slot='tools'>
    <JumpLink href='/archives' label='年度归档' />
    <JumpLink href='/tags' label='标签索引' />
  </Fragment>
  <section class='ln-blog-index' aria-label='文章列表'>
    <div class='ln-blog-index__meta'>
      <span>共 {page.total} 篇文章</span>
      <span>第 {page.currentPage} / {page.lastPage} 页</span>
    </div>
    <div class='ln-blog-index__posts'>
      {page.data.map((post, index) => <PostPreview {post} lead={index === 0} />)}
      {page.data.length === 0 && <p class='ln-blog-index__empty'>暂无文章。</p>}
    </div>
    <Pagination
      prevUrl={page.url.prev ? { text: '上一页', url: page.url.prev } : undefined}
      nextUrl={page.url.next ? { text: '下一页', url: page.url.next } : undefined}
    />
  </section>
</PageLayout>

<style>
  .ln-blog-index__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ln-space-3) var(--ln-space-6);
    padding-block: var(--ln-space-4);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    font-variant-numeric: tabular-nums;
  }
  .ln-blog-index__posts {
    min-width: 0;
  }
  .ln-blog-index__empty {
    margin: 0;
    padding-block: var(--ln-space-8);
    color: hsl(var(--ln-color-muted));
  }
</style>
