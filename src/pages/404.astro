---
import PageLayout from '@/layouts/PageLayout.astro'

const meta = {
  description: '找不到这个页面',
  title: '404'
}

const links = [
  { href: '/', label: '首页', note: '最近更新' },
  { href: '/tracking', label: '前沿追踪', note: '追踪与专题' },
  { href: '/blog', label: '文章', note: '全部文章' }
]
---

<PageLayout
  {meta}
  title='这个页面不存在'
  description='这个地址没有页面，可能是链接写错了。'
>
  <section class='ln-404'>
    <ul class='ln-404__links'>
      {
        links.map((link) => (
          <li>
            <a href={link.href} data-astro-prefetch>
              <span class='ln-404__label'>{link.label}</span>
              <span class='ln-404__note'>{link.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .ln-404__links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--ln-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ln-404__links a {
    display: block;
    padding: var(--ln-space-4);
    border: var(--ln-border-width) solid hsl(var(--ln-color-line));
    text-decoration: none;
    transition: border-color var(--ln-motion-fast) var(--ln-ease-standard);
  }

  .ln-404__links a:hover {
    border-color: hsl(var(--ln-color-accent));
    background-color: hsl(var(--ln-color-hover));
  }

  .ln-404__links a:active {
    background-color: hsl(var(--ln-color-press));
    box-shadow: inset 0 0 0 var(--ln-inset-ring) hsl(var(--ln-color-accent));
  }

  .ln-404__label {
    display: block;
    font-size: var(--ln-text-base);
    font-weight: var(--ln-weight-medium);
  }

  .ln-404__note {
    display: block;
    margin-top: var(--ln-space-1);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
  }
</style>




