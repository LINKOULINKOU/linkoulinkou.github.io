---
import relicSheet from '@/assets/decor/relic-small.png'

/**
 * 统一像素点缀「玫瑰徽章」：椭圆木框 + 手中花束，重绘自 Sparklehorse 封面。
 *
 * 图集由 script/make-relic.py 生成：1x 像素画按块内主色烘焙成实拍尺寸。
 * 动画与尺寸样式由 decor-frames.ts 生成、DecorStyles.astro 在 <head> 注入一次；
 * 组件只负责标记与静态规则。
 *
 * 动效：10 帧常驻循环、末帧无缝回首帧；高光巡游外框、花心逐朵点亮、细屑上升。
 * 离屏与转后台暂停，reduced-motion 完全不注册。
 */
---

<span class='ln-accent ln-accent--relic' data-pixel='relic' aria-hidden='true' style={`--sheet: url(${relicSheet.src})`}></span>

<style>
  .ln-accent {
    display: inline-block;
    box-sizing: content-box;
    flex: none;
    background-image: var(--sheet);
    background-repeat: no-repeat;
    background-position: 0 0;
    image-rendering: pixelated;
    vertical-align: middle;
    pointer-events: none;
  }

  /* 首次进视口后注册动画（is-seen 一次性），之后靠 is-visible 控制播放/暂停 */
  .ln-accent.is-seen {
    animation-name: var(--ln-anim);
    animation-duration: var(--ln-cycle);
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
    animation-delay: var(--ln-delay);
    animation-play-state: var(--ln-accent-play, running);
  }

  .ln-accent.is-seen:not(.is-visible),
  :global(html.is-background) .ln-accent {
    --ln-accent-play: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .ln-accent,
    .ln-accent.is-seen {
      animation: none !important;
      background-position: 0 0;
    }
  }
</style>

<script>
  const accents = Array.from(document.querySelectorAll<HTMLElement>('[data-pixel]'))
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (accents.length && !reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) entry.target.classList.add('is-seen')
          entry.target.classList.toggle('is-visible', entry.isIntersecting)
        }
      },
      { threshold: 0.25 }
    )
    for (const accent of accents) observer.observe(accent)

    const syncBackground = () => {
      document.documentElement.classList.toggle('is-background', document.hidden)
    }
    document.addEventListener('visibilitychange', syncBackground)
    syncBackground()
  }
</script>
