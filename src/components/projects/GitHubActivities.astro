---
import JumpLink from '@/components/navigation/JumpLink.astro'

/**
 * GitHub 活动图：构建时拉取 jogruber API 并静态渲染成格子（每格是链接，无 JS 也能点）。
 * 客户端增强由 contribution-calendar 管理，页面不再进入 Markdown prose。
 */
type Contribution = { date: string; count: number; level: number }

const USER = 'LINKOULINKOU'
const API = `https://github-contributions-api.jogruber.de/v4/${USER}?y=last`
const profileUrl = `https://github.com/${USER}`

let contributions: Contribution[] = []
let total: number | null = null
try {
  const res = await fetch(API, { signal: AbortSignal.timeout(20000) })
  if (res.ok) {
    const json = (await res.json()) as {
      total?: { lastYear?: number }
      contributions?: Contribution[]
    }
    contributions = json.contributions ?? []
    total = json.total?.lastYear ?? null
  }
} catch {
  // 拉取失败降级为链接，不阻断构建
}

// 列 = 周（周日起），行 = 星期
const cells: { c: Contribution; col: number; row: number }[] = []
if (contributions.length) {
  const pad = new Date(`${contributions[0].date}T00:00:00Z`).getUTCDay()
  contributions.forEach((c, i) => {
    const idx = i + pad
    cells.push({ c, col: Math.floor(idx / 7), row: idx % 7 })
  })
}
const weeks = cells.length ? Math.max(...cells.map((x) => x.col)) + 1 : 0

// 月份标签：周列首个单元格月份变化时打一个
const monthNames = [
  '1月',
  '2月',
  '3月',
  '4月',
  '5月',
  '6月',
  '7月',
  '8月',
  '9月',
  '10月',
  '11月',
  '12月'
]
const monthLabels: { col: number; label: string }[] = []
let lastMonth = ''
for (let col = 0; col < weeks; col++) {
  const first = cells.find((x) => x.col === col)
  if (!first) continue
  const label = monthNames[Number(first.c.date.slice(5, 7)) - 1]
  if (label !== lastMonth) {
    lastMonth = label
    monthLabels.push({ col, label })
  }
}
---

<section class='gh'>
  <div class='gh__head'>
    <h2 class='gh__title'>GitHub 活动</h2>
    {total !== null && <p class='gh__total'>{total}<span>过去一年的贡献</span></p>}
    <JumpLink class='gh__link' href={profileUrl} label='在 GitHub 查看' direction='external' external />
  </div>

  {
    contributions.length ? (
      <>
        <p class='gh__note'>
          悬停或聚焦查看单日数据，点击方格跳转到 GitHub 当天动态。
          <span data-gh-keyboard hidden>
            方向键切换日期，Home / End 跳到首末日。
          </span>
        </p>

        <div class='gh__wrap'>
          <div class='gh__months' style={`grid-template-columns: repeat(${weeks}, 10px)`}>
            {monthLabels.map((m) => (
              <span style={`grid-column: ${m.col + 1}; grid-row: 1`}>{m.label}</span>
            ))}
          </div>

          <div class='gh__body'>
            <div class='gh__weekdays'>
              <span style='grid-row: 2'>一</span>
              <span style='grid-row: 4'>三</span>
              <span style='grid-row: 6'>五</span>
            </div>

            <div
              class='gh__grid'
              data-gh-calendar
              style={`grid-template-columns: repeat(${weeks}, 10px)`}
            >
              {cells.map(({ c, col, row }) => (
                <a
                  class={`gh__cell gh__cell--lv${c.level}`}
                  style={`grid-column: ${col + 1}; grid-row: ${row + 1};`}
                  href={`${profileUrl}?tab=overview&from=${c.date}&to=${c.date}`}
                  aria-label={`${c.date}：${c.count} 次贡献`}
                  data-date={c.date}
                  data-count={c.count}
                />
              ))}
            </div>
          </div>

          <div class='gh__legend'>
            <span>少</span>
            {[0, 1, 2, 3, 4].map((lv) => (
              <span class={`gh__cell gh__cell--lv${lv}`} />
            ))}
            <span>多</span>
          </div>
        </div>
      </>
    ) : (
      <p class='gh__note'>
        贡献数据暂时未能获取 ·{' '}
        <JumpLink href={profileUrl} label='在 GitHub 查看' direction='external' external />
      </p>
    )
  }

  <div class='gh__tip' data-gh-tip aria-hidden='true'></div>
</section>

<script>
  import { initContributionCalendar } from './contribution-calendar'

  const calendar = document.querySelector<HTMLElement>('[data-gh-calendar]')
  const tip = document.querySelector<HTMLElement>('[data-gh-tip]')
  if (calendar && tip) {
    initContributionCalendar(calendar, tip)
    document.querySelector<HTMLElement>('[data-gh-keyboard]')?.removeAttribute('hidden')
  }
</script>

<style>
  .gh {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--ln-space-6) var(--ln-space-8);
  }

  .gh__head {
    grid-column: 1;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ln-space-4);
  }

  .gh__title {
    margin: 0;
    color: hsl(var(--ln-color-ink));
    font-size: var(--ln-text-section);
    font-weight: var(--ln-weight-strong);
  }

  .gh__total { margin: var(--ln-space-2) 0; color: hsl(var(--ln-color-accent)); font: var(--ln-text-page-title) / var(--ln-leading-title) var(--ln-font-mono); }
  .gh__total > span { display: block; margin-top: var(--ln-space-2); color: hsl(var(--ln-color-muted)); font: var(--ln-text-meta) / var(--ln-leading-meta) var(--ln-font-sans); }
  .gh__note {
    grid-column: 2;
    margin: 0;
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    line-height: var(--ln-leading-ui);
  }

  .gh__wrap {
    grid-column: 2;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .gh__months,
  .gh__grid,
  .gh__weekdays {
    display: grid;
    gap: 3px;
    font-size: 0.6875rem;
    line-height: 1.2;
    color: hsl(var(--ln-color-muted));
  }

  .gh__months {
    margin-left: 32px;
    margin-bottom: 4px;
    white-space: nowrap;
  }

  .gh__body {
    display: flex;
    gap: 6px;
  }

  .gh__weekdays {
    grid-template-rows: repeat(7, 10px);
    width: 26px;
  }

  .gh__weekdays span {
    text-align: right;
  }

  .gh__grid {
    grid-template-rows: repeat(7, 10px);
    width: fit-content;
  }

  .gh__cell {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background-color: hsl(var(--ln-color-line));
  }

  .gh__cell--lv1 {
    background-color: hsl(var(--ln-color-accent) / 0.35);
  }

  .gh__cell--lv2 {
    background-color: hsl(var(--ln-color-accent) / 0.55);
  }

  .gh__cell--lv3 {
    background-color: hsl(var(--ln-color-accent) / 0.78);
  }

  .gh__cell--lv4 {
    background-color: hsl(var(--ln-color-accent));
  }

  a.gh__cell:hover {
    outline: 1px solid hsl(var(--ln-color-ink) / 0.45);
  }

  .gh__legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    margin-top: var(--ln-space-2);
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
  }

  .gh__legend > span:first-child,
  .gh__legend > span:last-child {
    width: auto;
    height: auto;
    background: none;
  }

  .gh__tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    padding: 2px 8px;
    border-radius: var(--ln-radius-sm);
    background-color: hsl(var(--ln-color-ink));
    color: hsl(var(--ln-color-bg));
    font-size: var(--ln-text-meta);
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--ln-motion-hover) var(--ln-ease-standard);
  }
</style>
