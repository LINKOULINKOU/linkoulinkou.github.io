---
/**
 * 复制提示（toast）：本地替代 astro-pure 的 ThemeProvider 附带的 toast 监听。
 * 站点已改为只保留浅色，不再加载主题切换；但仍需承接 document 上的 'toast' 事件
 * （友链页复制按钮会 dispatch）。样式走 ln- token，不依赖主题的 Uno 工具类。
 */
---

<script>
  document.addEventListener('toast', (e) => {
    const { message, time } = (e as CustomEvent).detail
    if (!message) return
    const toast = document.createElement('div')
    toast.className = 'ln-toast'
    toast.setAttribute('role', 'status')
    toast.textContent = message
    document.body.appendChild(toast)
    // 下一帧加 is-visible，保证过渡生效
    requestAnimationFrame(() => toast.classList.add('is-visible'))
    setTimeout(() => {
      toast.classList.remove('is-visible')
      setTimeout(() => toast.remove(), 200)
    }, time || 2600)
  })
</script>

<style>
  :global(.ln-toast) {
    position: fixed;
    inset-block-end: var(--ln-space-6);
    inset-inline: 0;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin-inline: auto;
    padding: var(--ln-space-3) var(--ln-space-4);
    border: var(--ln-border-width) solid hsl(var(--ln-color-ink));
    background-color: hsl(var(--ln-color-bg));
    color: hsl(var(--ln-color-ink));
    font-size: var(--ln-text-sm);
    line-height: var(--ln-leading-ui);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity var(--ln-motion-base) var(--ln-ease-standard),
      transform var(--ln-motion-base) var(--ln-ease-standard);
    z-index: 20;
  }

  :global(.ln-toast.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }
</style>
