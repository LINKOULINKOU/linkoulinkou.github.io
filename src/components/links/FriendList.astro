---
/** 友链按数据中的分组和顺序静态输出，不依赖头像、随机排序或客户端脚本。 */
interface Friend {
  name: string
  intro: string
  link: string
}
interface Props {
  title?: string
  list: {
    id_name: string
    desc: string
    link_list: Friend[]
  }
}
const { title, list } = Astro.props
const heading = title ?? list.desc ?? list.id_name
---

{
  list.link_list.length > 0 ? (
    <section class='ln-friends' aria-labelledby={list.id_name}>
      <div class='ln-friends__head'>
        <h3 id={list.id_name}>{heading}</h3>
        <span>{list.link_list.length} 个站点</span>
      </div>
      <ul class='ln-friends__list'>
        {list.link_list.map((friend) => (
          <li>
            <a class='ln-friends__link' href={friend.link}>
              <span class='ln-friends__name'>{friend.name}</span>
              {friend.intro && <span class='ln-friends__intro'>{friend.intro}</span>}
              <span class='ln-friends__url'>{friend.link}</span>
              <span class='ln-friends__arrow' aria-hidden='true'>↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ) : (
    <p class='ln-friends__empty'>暂无友链。</p>
  )
}

<style>
  .ln-friends + .ln-friends {
    margin-top: var(--ln-space-10);
  }
  .ln-friends__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ln-space-4);
    padding-bottom: var(--ln-space-4);
  }
  .ln-friends h3 {
    margin: 0;
    font-size: var(--ln-text-sm);
    font-weight: var(--ln-weight-medium);
  }
  .ln-friends__head > span {
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    font-variant-numeric: tabular-nums;
  }
  .ln-friends__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ln-friends__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--ln-space-2) var(--ln-space-6);
    min-height: var(--ln-hit-min);
    padding-block: var(--ln-space-6);
    color: hsl(var(--ln-color-body));
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color var(--ln-motion-hover) var(--ln-ease-standard);
  }
  .ln-friends__link:hover,
  .ln-friends__link:focus-visible {
    background: hsl(var(--ln-color-hover));
  }
  .ln-friends__link:active {
    background: hsl(var(--ln-color-press));
  }
  .ln-friends__name {
    color: hsl(var(--ln-color-ink));
    font-size: var(--ln-text-list-title);
    font-weight: var(--ln-weight-medium);
  }
  .ln-friends__link:hover .ln-friends__name {
    color: hsl(var(--ln-color-accent));
  }
  .ln-friends__intro {
    grid-column: 1;
    font-size: var(--ln-text-base);
    line-height: var(--ln-leading-reading);
  }
  .ln-friends__url {
    grid-column: 1;
    color: hsl(var(--ln-color-muted));
    font-family: var(--ln-font-mono);
    font-size: var(--ln-text-meta);
    line-height: var(--ln-leading-meta);
  }
  .ln-friends__arrow {
    grid-column: 2;
    grid-row: 1;
    color: hsl(var(--ln-color-accent));
  }
  .ln-friends__empty {
    margin: 0;
    color: hsl(var(--ln-color-muted));
    font-size: var(--ln-text-meta);
    line-height: var(--ln-leading-meta);
  }
</style>
