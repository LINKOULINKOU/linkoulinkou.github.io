---
import type { InferEntrySchema } from 'astro:content'

import { formatDate } from '@/lib/format-date'
import config from 'virtual:config'

interface Props {
  data: InferEntrySchema<'blog'>
}

const {
  data: { title, publishDate }
} = Astro.props

const url = Astro.url
---

{/* 版权落款 */}
<footer class='ln-copyright'>
  <p class='ln-copyright__line ln-copyright__line--work'>
    <span class='ln-copyright__author'>{config.author}</span>
    <span class='ln-copyright__title'>{title}</span>
    <time datetime={formatDate(publishDate)}>{formatDate(publishDate)}</time>
  </p>
  <p class='ln-copyright__line ln-copyright__line--terms'>
    <span>{url.hostname}</span>
    <a href='https://creativecommons.org/licenses/by-nc-sa/4.0/' rel='license'>CC BY-NC-SA 4.0</a>
    <span>转载请注明出处</span>
  </p>
</footer>
